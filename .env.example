# Copy this file to .env and fill in real values locally.
# .env is git-ignored. Never commit real keys, tokens or connection strings.

# --- Data source for the dashboard: csv | supabase | dataverse ---
DATA_SOURCE=csv

# --- Supabase (only if DATA_SOURCE=supabase) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- Dataverse (only if DATA_SOURCE=dataverse) ---
DATAVERSE_URL=https://your-org.crm.dynamics.com
DATAVERSE_CLIENT_ID=your-app-client-id
DATAVERSE_CLIENT_SECRET=your-client-secret
DATAVERSE_TENANT_ID=your-tenant-id

# --- Simulated cost model (ASSUMPTIONS, not Microsoft billing) ---
# Prices in USD per 1,000 tokens, used to estimate est_cost_usd.
EST_INPUT_PRICE_PER_1K=0.003
EST_OUTPUT_PRICE_PER_1K=0.015

# --- Approval flow test inbox (your own test address only) ---
TEST_INBOX_EMAIL=you@example.com
